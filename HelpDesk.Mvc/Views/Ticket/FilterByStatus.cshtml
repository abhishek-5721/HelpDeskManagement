@model IEnumerable<HelpDesk.Mvc.Models.Ticket>

@{
    ViewData["Title"] = "Filter Tickets By Status";
}

<h2 class="text-primary">Filter Tickets By Status</h2>

<hr />

<form asp-action="FilterByStatus" method="post">
    <div class="row">
        <div class="col-md-4">
            <label class="form-label">
                Status
            </label>

            <select name="status" 
                    class="form-select"
                    asp-items="Html.GetEnumSelectList<Status>()">
            </select>
        </div>
    </div>

    <br />

    <input type="submit" value="Search" class="btn btn-primary" />
</form>

@if (Model != null && Model.Any())
{
    <hr />

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>

                <th>Title</th>

                <th>Priority</th>

                <th>Status</th>

                <th>Raised By</th>
            </tr>
        </thead> 
        <tbody>
            @foreach (var ticket in Model)
            {
                <tr>
                    <td>@ticket.Id</td>

                    <td>@ticket.Title</td>

                    <td>@ticket.Priority</td>

                    <td>@ticket.Status</td>

                    <td>@ticket.RaisedBy</td>

                    <td>@ticket.CreatedDate.ToString("dd-MMM-yyyy")</td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@ticket.Id"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@ticket.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@ticket.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (Model != null && !Model.Any())
{
    <div class="alert alert-warning">
        No tickets found for the selected status.
    </div>
}