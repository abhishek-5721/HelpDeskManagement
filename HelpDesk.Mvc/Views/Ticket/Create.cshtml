@model HelpDesk.Mvc.Models.Ticket

@{
    ViewData["Title"] = "Raise New Ticket";
}

<h2 class="text-primary">Raise New Ticket</h2>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>

                <input asp-for="Title" class="form-control" />

                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>

                <textarea asp-for="Description" class="form-control" rows="4">
                </textarea>

                <span asp-validation-for="Description" class="text-danger"></span>

            </div>
            
            <div class="mb-3">
                <label asp-for="Priority" class="form-label"></label>

                <select asp-for="Priority" asp-items="Html.GetEnumSelectList<Priority>()" class="form-select"></select>

                <span asp-validation-for="Priority" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="RaisedBy" class="form-label"></label>

                <input asp-for="RaisedBy" class="form-control" />

                <span asp-validation-for="RaisedBy" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <input type="submit" value="Create" class="btn btn-primary" />

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>