@{
    ViewData["Title"] = "Home";
}

<div class="text-center mt-5">

    <h1 class="display-4 text-primary">
        Help Desk Management System
    </h1>

    <p class="lead">
        Manage support tickets efficiently through a simple and user-friendly interface.
    </p>

    <hr class="w-50 mx-auto" />

    <div class="mt-4">

        <a asp-controller="Ticket"
           asp-action="Dashboard"
           class="btn btn-primary btn-lg m-2">
            Dashboard
        </a>

        <a asp-controller="Ticket"
           asp-action="Index"
           class="btn btn-success btn-lg m-2">
            View Tickets
        </a>

        <a asp-controller="Ticket"
           asp-action="Create"
           class="btn btn-warning btn-lg m-2">
            Raise Ticket
        </a>

    </div>

</div>